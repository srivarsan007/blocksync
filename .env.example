# BlockSync Environment Configuration Example
# Copy this file to .env and customize for your deployment environment.

# JWT Signing Secret (Generate with: openssl rand -hex 32)
# Required in production: when demo mode is off, BlockSync refuses to start without this.
PYJWT_SECRET=your-secure-random-jwt-signing-key-here

# Demo Mode Flag (defaults to 'false')
# Only seed demo accounts and expose /auth/accounts password hints when set explicitly to 'true'.
# WARNING: Never enable BLOCKSYNC_DEMO_MODE=true in a public or production environment!
BLOCKSYNC_DEMO_MODE=false

# Frontend API Base URL (if frontend and backend are hosted on different origins)
VITE_API_BASE_URL=http://127.0.0.1:8000
