# BlockSync Environment Configuration Example
# Copy this file to .env and customize for your deployment environment.

# JWT Signing Secret (Generate with: openssl rand -hex 32)
# If left unset, BlockSync falls back to a development key with a startup warning.
PYJWT_SECRET=your-secure-random-jwt-signing-key-here

# Enable/disable seeded demo accounts and password hints on GET /auth/accounts
# Set to 'true' or '1' for local evaluation, 'false' for production deployments
BLOCKSYNC_DEMO_MODE=true

# Frontend API Base URL (if frontend and backend are hosted on different origins)
VITE_API_BASE_URL=http://127.0.0.1:8000
